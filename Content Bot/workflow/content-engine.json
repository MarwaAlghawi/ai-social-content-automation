        },
        "messages": {
          "values": [
            {
              "content": "=You are a social media copywriter for {{ $('Get Brand').item.json.brand_name }}.\nTone: {{ $('Get Brand').item.json.tone }}\nAudience: {{ $('Get Brand').item.json.audience }}\n\nProduct notes: {{ $('Parse Message').item.json.notes }}\n\nWrite:\n1. caption_en: 2-3 short sentences in English with a soft call to action.\n2. caption_ar: the same message in natural Gulf-friendly Arabic, not a literal translation.\n3. hashtags: 6-8 relevant hashtags as one string separated by spaces.\n\nRules: use at most 2 emojis. Make no false claims (gold-plated, not solid gold).\nReturn ONLY valid JSON with keys caption_en, caption_ar, hashtags. No extra text."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1152,
        48
      ],
      "id": "3c72b93b-1ef0-4dab-8a34-8bea0a6bdfce",
      "name": "Write Captions"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Find the text, wherever Gemini put it\nconst text =\n  item.content?.parts?.[0]?.text ??\n  item.text ??\n  item.output ??\n  JSON.stringify(item);\n\n// Grab just the {...} part, in case Gemini added extra words\nconst match = text.match(/\\{[\\s\\S]*\\}/);\nconst data = JSON.parse(match[0]);\n\nreturn [{\n  json: {\n    caption_en: data.caption_en,\n    caption_ar: data.caption_ar,\n    hashtags: Array.isArray(data.hashtags) ? data.hashtags.join(' ') : data.hashtags,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        48
      ],
      "id": "44cc90b9-c8f0-4f3b-8cbf-48330dc86994",
